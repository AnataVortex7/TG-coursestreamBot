# Required Variables (DO NOT SKIP THESE)

API_ID=
API_HASH=
BOT_TOKEN=

# LOG_CHANNEL — used for legacy /stream/:id file links (admin upload → forward → link)
# For course streaming, each course has its OWN channel set via /addcourse.
# You still need LOG_CHANNEL for the bot to work; point it to any channel the bot is admin of.
LOG_CHANNEL=

# Optional Variables

DEV=false
PORT=8080

# The length of the hash in your URLs
# https://domain.tld/1254?hash=asd45a
#                              ^^^^^^
#                                /
#                         This is the hash

HASH_LENGTH=6

# you can use IP address
# HOST=http://<ip address>:<PORT>
# Or you can also use a domain name
# HOST=https://example.com

# Use public IP while auto-generating HOST (not recommended unless needed)
USE_PUBLIC_IP=false

# Reuse worker sessions from files (faster startup)
USE_SESSION_FILE=true

# Optional user session string for userbot features
# USER_SESSION=

# Optional allowlist of Telegram user IDs (comma-separated)
# ALLOWED_USERS=12345,67890

# Stream performance tuning
# STREAM_CONCURRENCY = parallel Telegram chunk downloads per stream request
# STREAM_BUFFER_COUNT = how many chunks to keep ready in memory
# STREAM_TIMEOUT_SEC = per-chunk timeout (seconds)
# STREAM_MAX_RETRIES = retries per failed chunk
#
# Good default:
# STREAM_CONCURRENCY=4
# STREAM_BUFFER_COUNT=8
# STREAM_TIMEOUT_SEC=30
# STREAM_MAX_RETRIES=3
STREAM_CONCURRENCY=4
STREAM_BUFFER_COUNT=8
STREAM_TIMEOUT_SEC=30
STREAM_MAX_RETRIES=3

# For muti token support
# Refer https://github.com/EverythingSuckz/TG-FileStreamBot/tree/golang#use-multiple-bots-to-speed-up

# MULTI_TOKEN1=1857821156:AAEvrINCsduhjkjhahadvHRdk7oF46KZnc
# MULTI_TOKEN2=1355359001:AAF4dgddVVxDCt51FZqy1unh9h0SOTw0gU
# MULTI_TOKEN3=6941936497:AAGJzfoMHXshS8gVcsefUzpwyrbfU7gKRMM
# MULTI_TOKEN4=6546079247:AAF2k3uvO9Hqadfhjaskjds8jnzOAfQYUzTZ

# ─────────────────────────────────────────────────────────────────────────────
# Course Streaming — MongoDB + Auth
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection URI (required for course/user/access features)
# Atlas example : mongodb+srv://user:pass@cluster.mongodb.net/
# Local example : mongodb://localhost:27017/
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# MongoDB database name (default: coursebot)
MONGODB_DB=coursebot

# JWT secret — used to sign login session tokens
# IMPORTANT: Change this to a long random string before deploying!
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string

# Stream token secret — used to AES-256-GCM encrypt /watch/:token URLs
# IMPORTANT: Must be exactly 32 bytes (64 hex chars) for AES-256
# Generate one with: openssl rand -hex 32
STREAM_SECRET=change-me-another-long-random-string

# ─────────────────────────────────────────────────────────────────────────────
# Brevo Email OTP Login (NEW)
# ─────────────────────────────────────────────────────────────────────────────
#
# How to get your SMTP key:
#   1. Login to app.brevo.com
#   2. Go to  Settings → SMTP & API
#   3. Click "Create a new SMTP key"
#   4. Copy the generated key below
#
# BREVO_SMTP_HOST — do NOT change unless Brevo changes their relay address
# BREVO_SMTP_PORT — 587 uses STARTTLS (recommended); 465 = SSL (change code if used)
# BREVO_SMTP_USER — your Brevo account login email
# BREVO_SMTP_PASS — the SMTP key from step above (NOT your account password)
# BREVO_FROM_EMAIL — the verified sender address in your Brevo account
# BREVO_FROM_NAME  — display name shown in the email client

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login@example.com
BREVO_SMTP_PASS=your-brevo-smtp-key-here
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=CourseStream

# ── Single active instance (redeploy overlap / AUTH_KEY_DUPLICATED protection) ──
# Navin instance jaruna instance band hoyparyant Telegram la connect karat nahi.
# INSTANCE_LOCK=false      -> lock band (junya sarkhe)
# INSTANCE_LOCK_KEY=<name> -> jar Old/New machine janiv-purvak vegvegle chalavayche asatil tar doghanna vegle key dya
INSTANCE_LOCK=true
#INSTANCE_LOCK_KEY=active_instance
