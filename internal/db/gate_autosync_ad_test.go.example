func TestMain(m *testing.M) {
	os.Setenv("MONGODB_URI", "mongodb://127.0.0.1:27099")
	os.Setenv("MONGODB_DB", "zz_test_"+time.Now().Format("150405"))
	Connect()
	EnsureAutoSyncIndexes()
	EnsureAutoDeliveryIndexes()
	code := m.Run()
	_ = Database.Drop(Ctxb())
	os.Exit(code)
}

func Ctxb() (c ctxT) { return ctxT{} }

type ctxT struct{}

func (ctxT) Deadline() (time.Time, bool) { return time.Time{}, false }
func (ctxT) Done() <-chan struct{}       { return nil }
func (ctxT) Err() error                  { return nil }
func (ctxT) Value(any) any               { return nil }

func TestMapPagingAndPlaceholders(t *testing.T) {
	tid := primitive.NewObjectID()
	for i := 1; i <= 250; i++ {
		if err := AutoSyncMapPut(tid, i, 1000+i); err != nil {
			t.Fatal(err)
		}
	}
	if n := AutoSyncMapCount(tid); n != 250 {
		t.Fatalf("count=%d", n)
	}
	after, got, last := 0, 0, 0
	for {
		page := AutoSyncMapPage(tid, after, 100)
		if len(page) == 0 {
			break
		}
		for _, p := range page {
			if p.Dest <= last {
				t.Fatalf("not ascending: %d after %d", p.Dest, last)
			}
			if p.Dest != 1000+p.Src {
				t.Fatalf("pair mismatch %v", p)
			}
			last = p.Dest
			got++
		}
		after = page[len(page)-1].Dest
	}
	if got != 250 {
		t.Fatalf("paged %d", got)
	}

	// placeholder lifecycle (real flow: PutPlaceholder first, then normal Put keeps flag)
	if err := AutoSyncMapPutPlaceholder(tid, 5, 1005); err != nil {
		t.Fatal(err)
	}
	if err := AutoSyncMapPut(tid, 5, 1005); err != nil {
		t.Fatal(err)
	}
	if l := AutoSyncPlaceholderList(tid, 6, 10); len(l) != 1 || l[0].SrcMsg != 5 {
		t.Fatalf("placeholder list: %v", l)
	}
	for i := 0; i < 6; i++ {
		AutoSyncPlaceholderTry(tid, 5)
	}
	if l := AutoSyncPlaceholderList(tid, 6, 10); len(l) != 0 {
		t.Fatalf("should be excluded after 6 tries: %v", l)
	}
	if AutoSyncPlaceholderCount(tid) != 1 {
		t.Fatal("count should still be 1")
	}
	AutoSyncPlaceholderDone(tid, 5)
	if AutoSyncPlaceholderCount(tid) != 0 {
		t.Fatal("done should clear")
	}

	// link pending
	AutoSyncLinkPending(tid, 7, true)
	if l := AutoSyncLinkPendingList(tid, 8, 10); len(l) != 1 || l[0].DestMsg != 1007 {
		t.Fatalf("link pending: %v", l)
	}
	for i := 0; i < 8; i++ {
		AutoSyncLinkTry(tid, 7)
	}
	if l := AutoSyncLinkPendingList(tid, 8, 10); len(l) != 0 {
		t.Fatalf("excluded after tries: %v", l)
	}
	AutoSyncLinkPending(tid, 7, true) // re-arm resets tries
	if l := AutoSyncLinkPendingList(tid, 8, 10); len(l) != 1 {
		t.Fatalf("re-arm failed: %v", l)
	}
	AutoSyncLinkPending(tid, 7, false)
	if l := AutoSyncLinkPendingList(tid, 8, 10); len(l) != 0 {
		t.Fatal("off failed")
	}
}

func TestFirstContactRace(t *testing.T) {
	raceID := int64(900000 + time.Now().Nanosecond()%100000)
	var wg sync.WaitGroup
	var mu sync.Mutex
	news := 0
	for i := 0; i < 25; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			isNew, err := RecordFirstContact(raceID, "Bob", "bob", "hi")
			if err != nil {
				t.Error(err)
				return
			}
			if isNew {
				mu.Lock()
				news++
				mu.Unlock()
			}
		}()
	}
	wg.Wait()
	if news != 1 {
		t.Errorf("isNew true %d times (want exactly 1) — duplicate admin notifications / duplicate docs", news)
	}
	ctx, cancel := Ctx()
	defer cancel()
	n, _ := colGateContacts().CountDocuments(ctx, bson.M{"tg_id": raceID})
	if n != 1 {
		t.Errorf("docs=%d want 1", n)
	}
}

func TestGateContactFlow(t *testing.T) {
	id := int64(777002)
	if isNew, _ := RecordFirstContact(id, "Al", "al", "/start"); !isNew {
		t.Fatal("first should be new")
	}
	if isNew, _ := RecordFirstContact(id, "Al", "al", "again"); isNew {
		t.Fatal("second must not be new")
	}
	SaveVerifiedContact(id, "9876543210", "Al")
	found := false
	for _, c := range ListUnregisteredVerifiedContacts(100) {
		if c.TGID == id {
			found = true
			if c.FirstMsg != "/start" || c.Mobile != "9876543210" {
				t.Errorf("fields: %+v", c)
			}
		}
	}
	if !found {
		t.Fatal("verified+unregistered not listed")
	}
	MarkContactRegistered(id)
	for _, c := range ListUnregisteredVerifiedContacts(100) {
		if c.TGID == id {
			t.Fatal("still listed after registered")
		}
	}
	// verified contact for a user who never sent a message first (contact share is first)
	SaveVerifiedContact(777003, "9000000001", "Zed")
	if GetGateContact(777003) == nil {
		t.Fatal("upsert by SaveVerifiedContact failed")
	}
}

func TestADClaimLifecycle(t *testing.T) {
	u, c := primitive.NewObjectID(), primitive.NewObjectID()
	if !ClaimADItem(u, c, 11, 5) {
		t.Fatal("first claim")
	}
	if ClaimADItem(u, c, 11, 5) {
		t.Fatal("second claim must fail (in flight)")
	}
	if !ADItemInFlight(u, c, 11) {
		t.Fatal("should be in flight")
	}
	// fresh claim is NOT stale
	if n := ReleaseStaleADClaims(90 * time.Second); n != 0 {
		t.Fatalf("fresh claim released: %d", n)
	}
	// backdate => stale
	ctx, cancel := Ctx()
	defer cancel()
	_, err := adItems().UpdateOne(ctx, bson.M{"user_id": u, "course_id": c, "message_id": 11},
		bson.M{"$set": bson.M{"updated_at": time.Now().Add(-10 * time.Minute)}})
	if err != nil {
		t.Fatal(err)
	}
	if n := ReleaseStaleADClaims(90 * time.Second); n != 1 {
		t.Fatalf("stale not released: %d", n)
	}
	if !ClaimADItem(u, c, 11, 5) {
		t.Fatal("reclaim after release")
	}
	// delivered => never claimable again
	if err := SaveADItem(ADItem{UserID: u, CourseID: c, MessageID: 11, ChatID: 5, SentMsgID: 99, State: ADStateDelivered}); err != nil {
		t.Fatal(err)
	}
	if ClaimADItem(u, c, 11, 5) || ADItemInFlight(u, c, 11) {
		t.Fatal("delivered item must not be claimable/in flight")
	}
	// lease expiry reclaim of an orphan (without startup release)
	if !ClaimADItem(u, c, 12, 5) {
		t.Fatal("claim 12")
	}
	_, _ = adItems().UpdateOne(ctx, bson.M{"user_id": u, "course_id": c, "message_id": 12},
		bson.M{"$set": bson.M{"updated_at": time.Now().Add(-adClaimLease - time.Minute)}})
	if !ClaimADItem(u, c, 12, 5) {
		t.Fatal("expired lease should be reclaimable")
	}
}
